@page
@model BitacoraModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "PEIA — Bitácora";
    ViewData["ActivePage"] = "Bitacora";
}
@section Styles {
    <link rel="stylesheet" href="~/css/bitacora.css" asp-append-version="true" />
}
<div class="page-header">
          <h1>Bitácora</h1>
          <p>Registro de auditoría de todas las acciones realizadas en el sistema</p>
        </div>

        <!-- KPI mini -->
        <div class="kpi-mini-grid">
          <div class="kpi-mini">
            <div class="kpi-icon blue">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <div class="kpi-mini-body">
              <p class="kpi-mini-label">Eventos hoy</p>
              <!-- ⚠️ PENDIENTE BACKEND: GET /api/bitacora/resumen -->
              <p class="kpi-mini-value pending-kpi" id="kpi-eventos-hoy">—</p>
            </div>
          </div>
          <div class="kpi-mini">
            <div class="kpi-icon red">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div class="kpi-mini-body">
              <p class="kpi-mini-label">Errores hoy</p>
              <p class="kpi-mini-value pending-kpi" id="kpi-errores-hoy">—</p>
            </div>
          </div>
          <div class="kpi-mini">
            <div class="kpi-icon green">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <div class="kpi-mini-body">
              <p class="kpi-mini-label">Usuarios activos hoy</p>
              <p class="kpi-mini-value pending-kpi" id="kpi-usuarios-activos">—</p>
            </div>
          </div>
          <div class="kpi-mini">
            <div class="kpi-icon orange">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div class="kpi-mini-body">
              <p class="kpi-mini-label">Total eventos (mes)</p>
              <p class="kpi-mini-value pending-kpi" id="kpi-eventos-mes">—</p>
            </div>
          </div>
        </div>

        <!-- Action bar -->
        <div class="action-bar">
          <div class="action-bar-left">
            <div class="search-box">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="searchBitacora" placeholder="Buscar por usuario, módulo o acción..." />
            </div>
            <select class="filter-select" id="filterModulo">
              <option value="">Todos los módulos</option>
              <option value="Auth">Autenticación</option>
              <option value="Inventario">Inventario</option>
              <option value="Pedidos">Pedidos</option>
              <option value="Usuarios">Usuarios</option>
              <option value="Roles">Roles</option>
              <option value="Reportes">Reportes</option>
              <option value="Configuracion">Configuración</option>
            </select>
            <select class="filter-select" id="filterNivel">
              <option value="">Todos los niveles</option>
              <option value="Info">Info</option>
              <option value="Warning">Warning</option>
              <option value="Error">Error</option>
            </select>
            <div class="date-range">
              <label>Desde</label>
              <input type="date" id="fechaDesde" />
              <label>Hasta</label>
              <input type="date" id="fechaHasta" />
            </div>
          </div>
          <div class="action-bar-right">
            <div class="export-group">
              <button class="btn-export" id="btnExportCSV">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Exportar CSV
              </button>
            </div>
          </div>
        </div>

        <!-- DataTable de la bitácora -->
        <div class="dt-wrapper">
          <div class="dt-scroll">
            <table class="dt-table" id="tableBitacora">
              <thead>
                <tr>
                  <th>Fecha / Hora</th>
                  <th>Usuario</th>
                  <th>Módulo</th>
                  <th>Acción</th>
                  <th>Detalle</th>
                  <th>Centro</th>
                  <th>Nivel</th>
                  <th>IP</th>
                </tr>
              </thead>
              <tbody id="tbodyBitacora">
                <!-- Filas de demostración (serán reemplazadas por el backend) -->
                <tr>
                  <td class="cell-mono">03/07/2026 07:12:31</td>
                  <td>
                    <div class="user-cell">
                      <div class="avatar-sm">JM</div>
                      <span>Jennifer Muñoz</span>
                    </div>
                  </td>
                  <td><span class="module-badge module-inventario">Inventario</span></td>
                  <td class="cell-primary">Crear producto</td>
                  <td class="cell-detail">Producto "Caja Estándar L" creado con stock inicial 200</td>
                  <td>Bodega Norte</td>
                  <td><span class="level-badge level-info">Info</span></td>
                  <td class="cell-mono small">192.168.1.10</td>
                </tr>
                <tr>
                  <td class="cell-mono">03/07/2026 06:58:04</td>
                  <td>
                    <div class="user-cell">
                      <div class="avatar-sm">AG</div>
                      <span>Ariel Guevara</span>
                    </div>
                  </td>
                  <td><span class="module-badge module-auth">Auth</span></td>
                  <td class="cell-primary">Inicio de sesión</td>
                  <td class="cell-detail">Autenticación exitosa desde Chrome / Windows</td>
                  <td>Global</td>
                  <td><span class="level-badge level-info">Info</span></td>
                  <td class="cell-mono small">200.68.42.11</td>
                </tr>
                <tr>
                  <td class="cell-mono">03/07/2026 06:45:12</td>
                  <td>
                    <div class="user-cell">
                      <div class="avatar-sm">JM</div>
                      <span>Jose M.</span>
                    </div>
                  </td>
                  <td><span class="module-badge module-pedidos">Pedidos</span></td>
                  <td class="cell-primary">Actualizar estado</td>
                  <td class="cell-detail">Pedido #P-0042 → estado "En tránsito"</td>
                  <td>Bodega Sur</td>
                  <td><span class="level-badge level-info">Info</span></td>
                  <td class="cell-mono small">10.0.0.5</td>
                </tr>
                <tr>
                  <td class="cell-mono">03/07/2026 06:10:00</td>
                  <td>
                    <div class="user-cell">
                      <div class="avatar-sm">SY</div>
                      <span>Sistema</span>
                    </div>
                  </td>
                  <td><span class="module-badge module-inventario">Inventario</span></td>
                  <td class="cell-primary">Alerta stock mínimo</td>
                  <td class="cell-detail">Producto "Pallet madera" bajó del umbral mínimo (stock: 3)</td>
                  <td>Bodega Norte</td>
                  <td><span class="level-badge level-warning">Warning</span></td>
                  <td class="cell-mono small">—</td>
                </tr>
                <tr>
                  <td class="cell-mono">02/07/2026 23:45:00</td>
                  <td>
                    <div class="user-cell">
                      <div class="avatar-sm">SY</div>
                      <span>Sistema</span>
                    </div>
                  </td>
                  <td><span class="module-badge module-auth">Auth</span></td>
                  <td class="cell-primary">Intento de sesión fallido</td>
                  <td class="cell-detail">Usuario "admin@@peia.mx" — contraseña incorrecta (3er intento)</td>
                  <td>Global</td>
                  <td><span class="level-badge level-error">Error</span></td>
                  <td class="cell-mono small">181.22.99.3</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="dt-footer">
            <span class="dt-info" id="bitacoraInfo">Cargando eventos…</span>
            <div class="dt-pagination" id="bitacoraPagination">
              <button id="btnPrevBit" disabled>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button class="active">1</button>
              <button id="btnNextBit" disabled>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
          </div>
        </div>
@section Scripts {
    <script src="~/js/bitacora.js" asp-append-version="true"></script>
}
