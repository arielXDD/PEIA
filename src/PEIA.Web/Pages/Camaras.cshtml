@page
@model CamarasModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "PEIA — Cámaras en vivo";
    ViewData["ActivePage"] = "Camaras";
}
@section Styles {
    <link rel="stylesheet" href="~/css/camaras.css" asp-append-version="true" />
}
<div class="page-header">
          <h1>Cámaras en vivo</h1>
          <p>Monitorea tus instalaciones en tiempo real.</p>
        </div>

        <!-- Camera Grid + Detail Panel -->
        <div class="camaras-layout">

          <!-- Camera Grid 2x2 -->
          <div class="camaras-grid" id="camarasGrid">
            <!-- Cards injected by JS -->
          </div>

          <!-- Detail Panel -->
          <aside class="camara-detail" id="camaraDetail">
            <div class="detail-empty" id="detailEmpty">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              <p>Selecciona una cámara para ver su detalle</p>
            </div>
            <div class="detail-content" id="detailContent" style="display:none;">
              <h3 class="detail-title" id="detailTitle">Cámara 1 — Zona A</h3>
              <div class="detail-fields">
                <div class="detail-field">
                  <span class="detail-label">Nombre</span>
                  <span class="detail-value" id="detailNombre">Cámara 1</span>
                </div>
                <div class="detail-field">
                  <span class="detail-label">Zona</span>
                  <span class="detail-value" id="detailZona">Zona A</span>
                </div>
                <div class="detail-field">
                  <span class="detail-label">IP</span>
                  <span class="detail-value" id="detailIp">
                    192.168.1.101
                    <span class="badge-status badge-online">En línea</span>
                  </span>
                </div>
                <div class="detail-field">
                  <span class="detail-label">Última revisión</span>
                  <span class="detail-value" id="detailRevision">18/06/2026 14:30</span>
                </div>
                <div class="detail-field">
                  <span class="detail-label">Estado de conexión</span>
                  <span class="detail-value" id="detailEstado">
                    <span class="badge-status badge-active">Activa</span>
                  </span>
                </div>
              </div>
              <div class="detail-actions">
                <button class="btn btn-primary" id="btnCapturar">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                  Capturar pantalla
                </button>
                <button class="btn btn-outline" id="btnReportar">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  Reportar incidencia
                </button>
                <button class="btn btn-outline" id="btnGrabaciones">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
                  Ver grabaciones
                </button>
              </div>
            </div>
          </aside>

        </div>

        <div class="modal-overlay" id="modalOverlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
          <div class="modal-content">
            <div class="modal-header">
              <h3 id="modalTitle">Cámara en vivo</h3>
              <button class="modal-close" id="modalClose" type="button" aria-label="Cerrar">×</button>
            </div>
            <div class="modal-body">
              <img class="modal-img" id="modalImg" src="" alt="" />
            </div>
            <div class="modal-footer">
              <span id="modalLabel">Feed en vivo</span>
              <span class="modal-hint">Presiona Esc para cerrar</span>
            </div>
          </div>
        </div>
@section Scripts {
    <script src="~/js/camaras.js" asp-append-version="true"></script>
}
