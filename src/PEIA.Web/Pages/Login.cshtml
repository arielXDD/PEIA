@page
@model LoginModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "PEIA — Iniciar sesión";
}

<main class="login-page">
  <section class="login-panel" aria-labelledby="login-title">
    <div class="login-content">
      <a class="brand" href="/Login" aria-label="PEIA, inicio">
        <svg class="brand-mark" viewBox="0 0 52 52" aria-hidden="true">
          <rect x="1" y="18" width="19" height="19" rx="4" fill="#1757d7" />
          <rect x="27" y="6" width="19" height="19" rx="4" fill="#1654d7" />
          <rect x="15" y="32" width="19" height="19" rx="4" fill="#3378ef" />
        </svg>
        <span>PEIA</span>
      </a>

      <header class="login-header">
        <h1 id="login-title">Plataforma Empresarial<br />Inteligente para Almacenes</h1>
        <p>Inicia sesión para continuar</p>
      </header>

      <form class="login-form" id="loginForm">
        <div class="form-group">
          <label for="email">Usuario o correo</label>
          <div class="field-shell">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
            <input type="text" id="email" name="email" placeholder="ej. usuario@@empresa.com" autocomplete="username" required />
          </div>
        </div>

        <div class="form-group">
          <label for="password">Contraseña</label>
          <div class="field-shell">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 15v2" /></svg>
            <input type="password" id="password" name="password" placeholder="••••••••••••••" autocomplete="current-password" required />
            <button type="button" class="toggle-password" id="togglePassword" aria-label="Mostrar contraseña">
              <svg id="eyeIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="2.5" /></svg>
            </button>
          </div>
        </div>

        <div class="form-options">
          <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
        </div>

        <button type="submit" class="btn-login" id="btnLogin">
          <span class="btn-text">Iniciar sesión</span>
          <svg class="button-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 5l7 7-7 7" /></svg>
          <span class="btn-spinner" id="btnSpinner" hidden>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 0 1 9 9" /></svg>
          </span>
        </button>

        <div class="login-error" id="loginError" hidden role="alert">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 7v6M12 17h.01" /></svg>
          <span id="loginErrorText">Usuario o contraseña incorrectos.</span>
        </div>
      </form>

      <footer class="login-footer">© 2025 PEIA. Todos los derechos reservados.</footer>
    </div>
  </section>
  <div class="warehouse-visual" aria-hidden="true"></div>
</main>

@section Scripts {
  <script src="~/js/login.js" asp-append-version="true"></script>
}
