@page
@model InventarioModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "PEIA — Inventario y Productos";
    ViewData["ActivePage"] = "Inventario";
}
@section Styles {
    <link rel="stylesheet" href="~/css/inventario.css" asp-append-version="true" />
}
<div class="page-header">
          <h1>Inventario y Productos</h1>
          <p>Control de stock y gestión de productos por centro</p>
        </div>

        <!-- KPI mini cards -->
        <section class="kpi-mini-grid">
          <div class="kpi-mini">
            <div class="kpi-icon blue" style="background:var(--blue-light);color:var(--blue);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <div class="kpi-mini-body"><p class="kpi-mini-label">Total productos</p><p class="kpi-mini-value" id="kpi-total">48</p></div>
          </div>
          <div class="kpi-mini">
            <div class="kpi-icon orange" style="background:var(--orange-light);color:var(--orange);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div class="kpi-mini-body"><p class="kpi-mini-label">Stock bajo</p><p class="kpi-mini-value" id="kpi-bajo">7</p></div>
          </div>
          <div class="kpi-mini">
            <div class="kpi-icon green" style="background:var(--green-light);color:var(--green);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            </div>
            <div class="kpi-mini-body"><p class="kpi-mini-label">Movimientos hoy</p><p class="kpi-mini-value" id="kpi-mov">34</p></div>
          </div>
          <div class="kpi-mini">
            <div class="kpi-icon purple" style="background:var(--purple-light);color:var(--purple);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="kpi-mini-body"><p class="kpi-mini-label">Valor estimado</p><p class="kpi-mini-value" id="kpi-valor">$284K</p></div>
          </div>
        </section>

        <!-- Action bar -->
        <div class="action-bar">
          <div class="action-bar-left">
            <div class="search-box">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="searchProducts" placeholder="Buscar por SKU, nombre o categoría..." />
            </div>
            <select class="filter-select" id="filterCategoria">
              <option value="">Todas las categorías</option>
              <option value="Embalaje">Embalaje</option>
              <option value="Almacenamiento">Almacenamiento</option>
              <option value="Seguridad">Seguridad</option>
              <option value="Herramientas">Herramientas</option>
              <option value="Limpieza">Limpieza</option>
            </select>
            <select class="filter-select" id="filterStock">
              <option value="">Todo el stock</option>
              <option value="normal">Normal</option>
              <option value="bajo">Stock bajo</option>
              <option value="agotado">Agotado</option>
            </select>
            <label class="switch-container" style="display:flex; align-items:center; gap:8px; margin-left: 10px;">
              <input type="checkbox" id="switchConsolidado" style="accent-color: var(--blue);" />
              <span class="text-sm">Stock Consolidado</span>
            </label>
          </div>
          <div class="action-bar-right">
            <button class="btn btn-primary" id="btnNuevoProducto">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Nuevo producto
            </button>
          </div>
        </div>

        <div id="productsTable"></div>
@section Scripts {
    <script src="~/js/components/data-table.js" asp-append-version="true"></script>
    <script src="~/js/components/modal-form.js" asp-append-version="true"></script>
    <script src="~/js/inventario.js" asp-append-version="true"></script>
}
