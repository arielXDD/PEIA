@{
    var activePage = ViewData["ActivePage"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/inicio.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-layout">
        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 28 28" fill="none"><rect x="2" y="8" width="10" height="10" rx="2" fill="#fff"/><rect x="16" y="2" width="10" height="10" rx="2" fill="#fff"/><rect x="10" y="16" width="10" height="10" rx="2" fill="rgba(255,255,255,.6)"/></svg>
                </div>
                <span>PEIA</span>
                <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Cerrar menú">×</button>
            </div>
            <nav class="sidebar-nav" aria-label="Navegación principal">
                <ul>
                    <li class="@(activePage == "Inicio" ? "active" : null)"><a asp-page="/Inicio"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>Inicio</a></li>
                    <li class="@(activePage == "Inventario" ? "active" : null)"><a asp-page="/Inventario"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>Inventario</a></li>
                    <li class="@(activePage == "Pedidos" ? "active" : null)"><a asp-page="/Pedidos"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="12" y2="16"/></svg>Pedidos</a></li>
                    <li class="@(activePage == "Reportes" ? "active" : null)"><a asp-page="/Reportes"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>Reportes</a></li>
                    <li class="@(activePage == "Roles" ? "active" : null)"><a asp-page="/Roles"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>Roles</a></li>
                    <li class="@(activePage == "Camaras" ? "active" : null)"><a asp-page="/Camaras"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>Cámaras</a></li>
                    <li class="@(activePage == "Prediccion" ? "active" : null)"><a asp-page="/Prediccion"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>Predicción</a></li>
                    <li class="@(activePage == "Notificaciones" ? "active" : null)"><a asp-page="/Notificaciones" class="has-badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>Notificaciones <span class="badge">0</span></a></li>
                    <li class="@(activePage == "Usuarios" ? "active" : null)"><a asp-page="/Usuarios"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Usuarios</a></li>
                    <li class="@(activePage == "Configuracion" ? "active" : null)"><a asp-page="/Configuracion"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>Configuración</a></li>
                    <li class="@(activePage == "Bitacora" ? "active" : null)"><a asp-page="/Bitacora"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>Bitácora</a></li>
                    <li class="@(activePage == "Guia" ? "active" : null)"><a asp-page="/Guia"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 1 1 5.82 1c-.82 1.31-2.91 1.18-2.91 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>Guía</a></li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <button class="btn-logout" id="btnLogout" type="button">Cerrar sesión</button>
            </div>
        </aside>
        <main class="main-area">
            <header class="topbar">
                <div class="topbar-left">
                    <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false">☰</button>
                    <div class="warehouse-selector">
                        <span id="activeCentro">Centro activo</span>
                        <span aria-hidden="true">⌄</span>
                        <div class="warehouse-dropdown" id="warehouseDropdown"></div>
                    </div>
                </div>
                <div class="topbar-right">
                    <div class="user-menu" id="userMenu">
                        <div class="avatar" id="userAvatar">PE</div>
                        <span class="user-name" id="userName">Usuario PEIA</span>
                    </div>
                </div>
            </header>
            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/components/toast.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
